# Kopieer naar .env.local en vul in. Zet dezelfde waarden ook op Vercel.
# .env.local staat in .gitignore — commit NOOIT echte keys.

# Productiedomein — gebruikt in de CORS-allowlist van /api/rpc.
NEXT_PUBLIC_SITE_URL=https://solanasweeper.com

# Reown AppKit project ID — gratis op https://cloud.reown.com
NEXT_PUBLIC_REOWN_PROJECT_ID=your-reown-project-id

# Helius RPC-URL (SERVER-ONLY, niet NEXT_PUBLIC) — geproxyd door /api/rpc.
# Vorm: https://mainnet.helius-rpc.com/?api-key=<key>
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=your-helius-key

# Fee-wallet (publiek adres) — bestemming voor de platform-fee, en de 75%-helft bij referrals.
NEXT_PUBLIC_FEE_WALLET=your-fee-wallet-address

# Jupiter platform-fee account (wSOL token-account voor de swap-fee). Optioneel.
NEXT_PUBLIC_JUP_FEE_ACCOUNT=your-jup-fee-account

# ── Referral-programma (Supabase) ──
# Project-URL (publiek is prima).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# SERVICE ROLE key — SERVER-ONLY. Bypasst RLS en heeft volledige DB-toegang.
# NOOIT met NEXT_PUBLIC_ prefix, NOOIT committen, NOOIT in client-code. Alleen in
# .env.local (lokaal) en de Vercel-env (Production/Preview).
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
